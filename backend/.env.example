# ⚠️ NE JAMAIS COMMIT UN .env AVEC DES VALEURS DE PRODUCTION
# La clé APP_KEY doit être générée via : php artisan key:generate
# ──────────────────────────────────────────────────────────────
# Sortie d'école — .env.example
# Copier vers .env et adapter les valeurs.
# ──────────────────────────────────────────────────────────────

APP_NAME="Sortie d'école"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# ── Base de données (PostgreSQL 16+ obligatoire, jamais SQLite) ─
DB_CONNECTION=pgsql
DB_HOST=postgresql
DB_PORT=5432
DB_DATABASE=sortie_ecole
DB_USERNAME=sortie
DB_PASSWORD=secret

# ── Redis (cache, queues, sessions) ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ── Laravel Reverb (WebSockets temps réel) ───────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sortie-ecole
REVERB_APP_KEY=sortie-reverb-key
REVERB_APP_SECRET=sortie-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ── MinIO (Stockage privé photos — hébergé au Maroc) ────────
FILESYSTEM_DISK=minio
AWS_ACCESS_KEY_ID=sortie-minio
AWS_SECRET_ACCESS_KEY=sortie-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=photos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8000,admin.sortie-ecole.ma

# ── Filament (sous-domaine admin) ────────────────────────────
FILAMENT_DOMAIN=admin.sortie-ecole.ma

# ── Mail (dev : log) ────────────────────────────────────────
MAIL_MAILER=log

# ── SMS Gateway ──────────────────────────────────────────────
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=SortieEcole

# ── Notifications push (payload opaque, pas de données perso) ─
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Frontend URL (CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000
